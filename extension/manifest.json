{
  "manifest_version": 3,
  "name": "Traceit",
  "version": "1.0.0",
  "description": "Analyze web performance and generate actionable insights for developers.",
  
  "permissions": [
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Traceit"
  },

  "background": {
    "service_worker": "background/service_worker.js"
  }
}